# Copy to `.env` beside docker-compose.yml. Never commit the real one.
#
# Two values have no default on purpose: a compose file that boots with a
# known password and a known signing key is a compose file somebody puts on
# the internet.

# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=

POSTGRES_USER=warehouse_app
POSTGRES_DB=warehouse
WEB_PORT=8080

# The addresses people actually reach this on. PUBLIC_WEB_URL is what a
# password-reset link opens; PUBLIC_APP_URL is what a document's QR code
# points at, which is the API.
PUBLIC_WEB_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080/api

# Until this is set, "I forgot my password" cannot reach anyone: the link is
# created and logged as undeliverable, and the way back in is an Owner
# setting the password from Settings -> Users.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# NOTIFICATION_FROM_EMAIL=no-reply@yourcompany.example

# Where an in-app upgrade request is emailed. Without it the request is
# still written to the audit trail and logged at warn -- but somebody has
# to be reading the logs, because there is no payment gateway yet and this
# is how a customer says "take my money".
# SALES_NOTIFICATION_EMAIL=sales@yourcompany.example

# --- Android app (optional) --------------------------------------------------
# Set both once you have built the TWA, so this domain claims the app and it
# opens without a URL bar. `ops/twa/fingerprint.sh` prints the second one.
# ANDROID_PACKAGE_NAME=com.yourcompany.warehouse
# ANDROID_SHA256_FINGERPRINT=AB:CD:...:EF
