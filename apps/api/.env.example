# Copy to .env for local development. Never commit .env.
PORT=3000

# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://warehouse_app:warehouse_dev_local@localhost:5432/warehouse_dev

# Generate a real secret per environment, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-local-dev-only

# Base URL the QR codes on generated documents point at (document-engine.md §4).
PUBLIC_APP_URL=http://localhost:3000

# Local directory generated document PDFs are stored under (DECISIONS.md §24 --
# V1's stand-in for the locked "S3-compatible object storage" decision).
ATTACHMENTS_DIR=./storage/attachments

# Only set this if puppeteer-core can't find a system Chromium on its own
# (e.g. this repo's own sandbox, which points it at a pre-installed browser).
# A normal deployment that ran `npx puppeteer browsers install chrome` should
# leave this unset.
# PUPPETEER_CHROMIUM_EXECUTABLE=/opt/pw-browsers/chromium
