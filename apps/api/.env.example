# Copy to .env for local development. Never commit .env.
PORT=3000

# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://warehouse_app:warehouse_dev_local@localhost:5432/warehouse_dev

# Generate a real secret per environment, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-local-dev-only

# Base URL the QR codes on generated documents point at (document-engine.md §4).
# This is the API's own address: the QR opens /verify/:token, which this app serves.
PUBLIC_APP_URL=http://localhost:3000

# Where the *web app* is served. Used to build the link in a password-reset
# email, which has to open a screen rather than a JSON endpoint -- so this is
# deliberately not PUBLIC_APP_URL.
PUBLIC_WEB_URL=http://localhost:5173

# --- Where attachments live --------------------------------------------------
# Generated PDFs, KYC uploads, gate photographs, captured signatures.
#
# A local directory is the default and is fine for one API container. Name a
# bucket and it switches to object storage automatically -- which is what
# makes a second container possible, since two of them cannot share a disk.
ATTACHMENTS_DIR=./storage/attachments

# S3-compatible object storage. Works against AWS, MinIO, Cloudflare R2,
# DigitalOcean Spaces or Wasabi -- set S3_ENDPOINT for anything but AWS, and
# S3_FORCE_PATH_STYLE=true for anything whose DNS does not resolve
# <bucket>.<host> (MinIO always; some others).
#
# Leave the keys unset to use the SDK's own credential chain -- an instance
# role or a task role -- which is how a deployment avoids holding long-lived
# keys at all.
# S3_BUCKET=warehouse-attachments
# S3_REGION=ap-south-1
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=warehouse
# Set to `local` to keep files on disk even when a bucket is named -- for a
# staging copy of production's environment that should not write to it.
# ATTACHMENT_STORAGE=local

# Required. Every generated PDF is rendered by a real browser, and
# `puppeteer-core` -- unlike `puppeteer` -- never goes looking for one: it is
# the library without the bundled download, so a path is the only way it
# learns where Chrome is. Unset, the API starts, serves everything else, and
# fails on the first "Generate document".
#
# Debian/Ubuntu:  apt-get install chromium   ->  /usr/bin/chromium
# The container image in apps/api/Dockerfile installs it and sets this for you.
PUPPETEER_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Largest single upload POST /attachments will accept, in bytes (default
# 10 MB). Enforced twice: multer stops reading at the socket, and the
# service checks again so the message can say the size in words.
# ATTACHMENT_MAX_BYTES=10485760

# --- Signed document links (tenancy-and-security.md §5) ----------------------
# Signs the short-lived links POST /documents/:id/download-link mints, so a PDF
# can be embedded or forwarded without sharing a session. Falls back to
# JWT_SECRET when unset, which is fine; set a separate value if you want to be
# able to rotate one without invalidating the other.
# DOCUMENT_LINK_SECRET=
# How long a minted link lives. Short on purpose: a link is a bearer
# capability and cannot be revoked before it expires.
# DOCUMENT_LINK_TTL_SECONDS=300

# --- Notification delivery (blueprint §56) -----------------------------------
# Email. One connection string, the way a provider hands it to you:
#   smtp://user:pass@host:587   (STARTTLS)  |  smtps://... (implicit TLS)
# Unset means the email channel is not configured: those notifications stay
# pending and visible, rather than being marked sent.
#
# It is also what delivers password-reset links. Without it "I forgot my
# password" cannot reach anyone -- the link is created and logged as
# undeliverable, and the way back in is an Owner setting the password from
# Settings -> Users. Set this before letting real users sign themselves up.
# SMTP_URL=
# NOTIFICATION_FROM_EMAIL=no-reply@yourcompany.example
# WhatsApp and SMS post JSON to whatever endpoint you point them at
# ({channel, to, subject, text, severity}), with the token as a bearer.
# No provider is chosen yet (DECISIONS.md §13), so this stays generic.
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_WEBHOOK_TOKEN=
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
# How many times a failing notification is retried before it is left 'failed'
# with the provider's last error still on the row.
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_BATCH_SIZE=100

# --- Rate limiting -----------------------------------------------------------
# A generous per-IP backstop on every route; the anonymous endpoints set their
# own, much tighter limits (see src/throttling.ts for why the global one is
# deliberately loose).
# RATE_LIMIT_MAX=2000
# RATE_LIMIT_TTL_MS=60000
# Login/signup, keyed per (IP, email) rather than per IP.
# AUTH_RATE_LIMIT_MAX=8
# AUTH_RATE_LIMIT_TTL_MS=60000
# The public QR verify endpoint, which writes a row per matching hit.
# VERIFY_RATE_LIMIT_MAX=60
# VERIFY_RATE_LIMIT_TTL_MS=60000

# Number of proxy hops to trust for the client IP. Leave at 0 unless this
# deployment really is behind a proxy you control: X-Forwarded-For is
# client-settable, so trusting it on a directly-reachable host lets anyone
# forge their address, mint fresh rate-limit buckets, and poison audit_logs.
# TRUST_PROXY_HOPS=1
