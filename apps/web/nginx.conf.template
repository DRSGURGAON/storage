server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Security headers for the half of the deployment that actually serves
  # HTML. The API sets its own (helmet, in apps/api/src/main.ts) and
  # deliberately sets no CSP, because it never returns a page.
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # 'unsafe-inline' for styles is Ant Design: it injects component styles
  # into <style> tags at runtime. Scripts have no such exemption.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'" always;

  # Hashed asset filenames, so they can be cached hard. index.html cannot:
  # it is what points at the new hashes after a deploy.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  # Same-origin API. `/api/grns` reaches the API as `/grns`, exactly as the
  # dev server's proxy does.
  location /api/ {
    proxy_pass ${API_PROXY_TARGET}/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # A billing run over a long period, or a PDF render, outlasts the 60s
    # default; a gateway timeout mid-render leaves the caller unable to tell
    # whether the document was issued.
    proxy_read_timeout 180s;
    client_max_body_size 25m;
  }

  # Digital Asset Links, for a Play Store listing built as a Trusted Web
  # Activity. Android fetches this file to confirm that the APK and this
  # domain belong to the same people; without it the app opens with a URL
  # bar across the top, which is the difference between "an app" and "a
  # browser somebody skinned".
  #
  # It has to be its own location: the SPA fallback below answers every
  # unknown path with index.html, so without this Android would fetch the
  # app's HTML, fail to parse it as JSON, and report a verification failure
  # that looks like a signing problem.
  #
  # The file is written at container start by 30-assetlinks.sh, and only
  # when ANDROID_PACKAGE_NAME and ANDROID_SHA256_FINGERPRINT are both set.
  # A 404 here means "no app is claimed", which is honest; a file with the
  # wrong fingerprint in it would be worse than none.
  location = /.well-known/assetlinks.json {
    alias /etc/nginx/well-known/assetlinks.json;
    default_type application/json;
    add_header Cache-Control "no-cache";
  }

  # Every other path is the single-page app's own routing.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
